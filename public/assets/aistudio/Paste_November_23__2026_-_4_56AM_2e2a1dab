data class PlannedSet(
    val id: String,
    val tag: SetTag? = null,
    val workingSubTag: WorkingSubTag? = null, // only valid when tag == WORKING
    val repRange: String? = null,             // e.g. "8" or "8-10"; null when RPE-only
    val targetRpe: String? = null,            // e.g. "8", "8.5", or "8-9" (6.0–10.0 in 0.5 steps)
