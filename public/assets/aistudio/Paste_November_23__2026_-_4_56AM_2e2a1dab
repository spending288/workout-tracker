data class RoutineExercise(
    val id: String,
    val name: String,
    val targetSets: Int,                      // 1..20
    val repRange: String,                     // derived summary, or "" if all sets are RPE-only
    val targetRpe: String? = null,            // derived summary RPE
    val restSeconds: Int? = null,             // exercise-level default rest
    val plannedSets: List<PlannedSet>? = null // stored whenever per-set customization exists
)

data class Routine(
    val id: String,
    val name: String,
    val focus: String? = null,
    val description: String? = null,
    val exercises: List<RoutineExercise>,
