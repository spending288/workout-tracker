    val tag: SetTag? = null,
    val workingSubTag: WorkingSubTag? = null,
    val targetRepRange: String? = null,
    val targetRpe: String? = null,
    val restSeconds: Int? = null,
    val rpe: Double? = null                   // logged actual RPE: 6.0..10.0 (0.5 step)
)

data class ActiveExercise(
    val id: String,
    val name: String,
    val targetSets: Int,
    val repRange: String,
    val targetRpe: String? = null,
    val restSeconds: Int? = null,
    val sets: List<WorkoutSet>
)

data class ActiveWorkout(
    val id: String,
    val routineId: String? = null,
    val routineName: String,
    val startedAt: Long,                      // epoch ms
    val exercises: List<ActiveExercise>,
